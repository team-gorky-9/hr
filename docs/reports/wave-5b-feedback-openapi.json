  "components": {
    "schemas": {
      "Answer": {
        "properties": {
          "question_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,49}$",
            "title": "Question Key"
          },
          "value": {
            "type": "integer",
            "title": "Value"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question_key",
          "value"
        ],
        "title": "Answer"
      },
      "CodeIssue": {
        "properties": {
          "group_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,49}$",
            "title": "Group Key"
          },
          "count": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "Count"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "group_key",
          "count"
        ],
        "title": "CodeIssue"
      },
      "CycleCreate": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Title"
          },
          "question_version": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Question Version"
          },
          "questions": {
            "items": {
              "$ref": "#/components/schemas/Question"
            },
            "type": "array",
            "maxItems": 50,
            "minItems": 1,
            "title": "Questions"
          },
          "topic_options": {
            "items": {
              "$ref": "#/components/schemas/Topic"
            },
            "type": "array",
            "maxItems": 50,
            "minItems": 1,
            "title": "Topic Options"
          },
          "groups": {
            "items": {
              "$ref": "#/components/schemas/Group"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Groups"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "title",
          "question_version",
          "questions",
          "topic_options",
          "groups"
        ],
        "title": "CycleCreate"
      },
      "Group": {
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,49}$",
            "title": "Key"
          },
          "label": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Label"
          },
          "eligible_count": {
            "type": "integer",
            "maximum": 100000.0,
            "minimum": 1.0,
            "title": "Eligible Count"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "key",
          "label",
          "eligible_count"
        ],
        "title": "Group"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Policy": {
        "properties": {
          "k": {
            "type": "integer",
            "maximum": 100000.0,
            "minimum": 2.0,
            "title": "K"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "k"
        ],
        "title": "Policy"
      },
      "PublicationCreate": {
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Revision"
          },
          "policy": {
            "$ref": "#/components/schemas/Policy"
          },
          "policy_basis": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Policy Basis"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_revision",
          "policy",
          "policy_basis"
        ],
        "title": "PublicationCreate"
      },
      "Question": {
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,49}$",
            "title": "Key"
          },
          "text": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Text"
          },
          "min": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Min"
          },
          "max": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Max"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "key",
          "text",
          "min",
          "max"
        ],
        "title": "Question"
      },
      "ResponseCreate": {
        "properties": {
          "access_code": {
            "type": "string",
            "maxLength": 200,
            "minLength": 20,
            "title": "Access Code"
          },
          "answers": {
            "items": {
              "$ref": "#/components/schemas/Answer"
            },
            "type": "array",
            "maxItems": 50,
            "minItems": 1,
            "title": "Answers"
          },
          "topic_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,49}$",
            "title": "Topic Key"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "access_code",
          "answers",
          "topic_key"
        ],
        "title": "ResponseCreate"
      },
      "Revision": {
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Revision"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_revision"
        ],
        "title": "Revision"
      },
      "Topic": {
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,49}$",
            "title": "Key"
          },
          "label": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Label"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "key",
          "label"
        ],
        "title": "Topic"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
