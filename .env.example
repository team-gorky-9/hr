# Скопируйте в .env и при необходимости поменяйте. Файл .env в Git не попадает.

# База для приложения и миграций (драйвер psycopg 3).
DATABASE_URL=postgresql+psycopg://hr:hr@localhost:5432/hr

# Отдельная база для тестов: тесты создают в ней схему миграциями
# и откатывают каждую проверку. Не указывайте здесь рабочую базу.
TEST_DATABASE_URL=postgresql+psycopg://hr:hr@localhost:5432/hr_test

# Адреса фронтенда, которым API разрешает запросы из браузера (CORS), JSON-списком.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Параметры контейнера из docker-compose.yml.
POSTGRES_USER=hr
POSTGRES_PASSWORD=hr
POSTGRES_DB=hr
POSTGRES_PORT=5432
