# Скопируйте в .env и при необходимости поменяйте. Файл .env в Git не попадает.

# База для приложения и миграций (драйвер psycopg 3).
DATABASE_URL=postgresql+psycopg://hr:hr@localhost:5432/hr

# Отдельная база для тестов: тесты создают в ней схему миграциями
# и откатывают каждую проверку. Не указывайте здесь рабочую базу.
TEST_DATABASE_URL=postgresql+psycopg://hr:hr@localhost:5432/hr_test

# Адреса фронтенда, которым API разрешает запросы из браузера (CORS), JSON-списком.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Рабочий поиск требует отдельный серверный ключ. Учебный доступен без ключа.
HR_SEARCH_WORK_TOKEN=
HR_SEARCH_SEMANTIC_ENABLED=true

# Параметры контейнера из docker-compose.yml.
POSTGRES_USER=hr
POSTGRES_PASSWORD=hr
POSTGRES_DB=hr
POSTGRES_PORT=5432

# Языковая модель (контракт assessment.md, п. 2). Ключ — только в .env, в Git не попадает.
LLM_PROVIDER=yandexgpt
LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
LLM_EXTRACT_MODEL=gpt://{folder}/yandexgpt-lite/latest
LLM_ASSESS_MODEL=gpt://{folder}/yandexgpt/latest
LLM_TEMPERATURE=0
LLM_TIMEOUT_SEC=30
LLM_MAX_RETRIES=1
# auto: сначала response_format=json_schema, при отказе провайдера — JSON по инструкции.
LLM_STRUCTURED_MODE=auto
